      "from": "git push",
      "to": "next build",
      "type": "request"
    },
    {
      "from": "next build",
      "to": "CDN",
      "type": "data"
    },
    {
      "from": "CDN",
      "to": "reader",
      "type": "data"
    },
    {
      "from": "visitor",
      "to": "cached render",
      "type": "request"
    },
    {
      "from": "cached render",
      "to": "Vercel Blob",
      "type": "request"
    },
    {
      "from": "Vercel Blob",
      "to": "cached render",
      "type": "data"
    }
  ]
}
