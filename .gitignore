# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# recorded narrations live in object storage; see content/audio.json
/public/audio/

# Private raw source material (paid course transcripts): never commit
raw/
# PGlite runtime, copied from node_modules at build time
public/pglite/

# Second brain pipeline (second-brain/): private data must never reach this public repo
second-brain/data/
second-brain/.env*
!second-brain/.env.example
second-brain/.venv/
second-brain/.claude/
second-brain/.vscode/
credentials.json
token.json
*.sqlite
*.sqlite3
*.egg-info/
__pycache__/
.pytest_cache/
.ruff_cache/
.chroma/
