GOOGLE_CLIENT_SECRETS=credentials.json
GOOGLE_TOKEN_PATH=token.json
# LLM stage uses `claude -p` on your Claude subscription. Do NOT set ANTHROPIC_API_KEY here:
# an API key in the environment overrides the subscription and bills the API instead.
CLAUDE_BIN=
TRIAGE_MODEL=sonnet
POLISH_MODEL=sonnet
NOTION_TOKEN=
NOTION_RESOURCES_DB_ID=
NOTION_TOPICS_DB_ID=
NOTION_NEWSLETTERS_DB_ID=
DB_PATH=data/newsletter_brief.sqlite
MAX_ITEMS_PER_DAY=30
# Contact the SEC will see in the User-Agent of EDGAR requests (required for the EDGAR adapter)
SEC_CONTACT=
